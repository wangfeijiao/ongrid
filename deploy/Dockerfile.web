# syntax=docker/dockerfile:1.7
# ongrid-web image — multi-stage. Stage 1 builds the SPA from web/, stage 2
# bakes the built assets into nginx. nginx.conf and TLS certs are bind-mounted
# at runtime by docker-compose, so operators can edit them without rebuilding.
# Build context MUST be the repo root (Dockerfile lives in deploy/, but it
# COPYs `web/` from the root).

ARG VERSION=dev

# ---------- Stage 1: build the SPA ----------
# The SPA output is architecture-independent. Build it once on the native
# runner instead of running npm/TypeScript under QEMU for the arm64 target.
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

ARG VERSION
WORKDIR /app

# Cache dependency install layer separately from the source tree.
# `--mount=type=cache,target=/root/.npm` keeps npm's package cache
# across rebuilds — without it `npm ci` always re-downloads ~300MB.
COPY web/package.json web/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline

COPY web/ ./
# Preserve the repository-relative guide import used by the embedded onboarding guide.
COPY docs/guides/apm-configuration-files.md /docs/guides/apm-configuration-files.md
# vite cache persists the build artefact cache between rebuilds too,
# so a no-op web build drops from ~40s to ~5s.
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/app/node_modules/.vite \
    npm run build

# ---------- Stage 2: nginx + static assets ----------
# ubuntu:22.04 + distro nginx (was nginx:1.27-alpine). Same reason as the
# ongrid image: operators exec into this container to debug (check upstream
# reachability, tail logs, curl the API through the proxy), so it ships a
# real shell and the usual Linux toolbox instead of a stripped alpine layer.
# The rendered SPA is architecture-independent, so it is always built on
# $BUILDPLATFORM above and just copied in here.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8
RUN set -eux; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            nginx ca-certificates tzdata \
            bash bash-completion sudo \
            procps net-tools iproute2 iputils-ping iputils-tracepath dnsutils \
            traceroute \
            python3 \
            netcat-openbsd telnet \
            curl wget vim nano less tree unzip zip jq lsof tcpdump file && break; \
        [ "$i" = 5 ] && exit 1; echo "apt attempt $i failed, retrying in 5s"; sleep 5; \
    done; \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone; \
    rm -rf /var/lib/apt/lists/*

# Built SPA assets shipped inside the image so it can serve standalone if
# operators forget the bind-mount (ADR-008).
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Default fallback config — overridden by docker-compose bind-mount in
# production. Lets the image run as a smoke test image without extra files.
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf

# The distro package ships a default site; our nginx.conf does not include
# sites-enabled, so drop it to avoid confusion when debugging.
RUN rm -f /etc/nginx/sites-enabled/default && mkdir -p /var/log/nginx

EXPOSE 80 443

# Distro nginx daemonizes by default; keep PID 1 in the foreground.
CMD ["nginx", "-g", "daemon off;"]
