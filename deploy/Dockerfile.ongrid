# syntax=docker/dockerfile:1.7
# ongrid cloud service image — multi-stage, Ubuntu 22.04 final.
# Build context MUST be the repo root (see Makefile target `docker-ongrid`).

ARG VERSION=dev

# ---------- Stage 1: builder ----------
# We need CGO for the fastembed-go local embedder (yalue/onnxruntime_go
# is a thin cgo wrapper over libonnxruntime). Switched base from
# golang:1.25-alpine to bookworm so the build host has gcc + glibc to
# satisfy the cgo link step + the runtime image (also debian) so the
# onnxruntime .so finds its dependencies (libstdc++, libgomp).
FROM golang:1.25-bookworm AS builder

ARG VERSION
ARG TARGETARCH
WORKDIR /app

RUN set -eux; \
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            build-essential pkg-config && break; \
        [ "$i" = 5 ] && exit 1; echo "apt attempt $i failed, retrying in 5s"; sleep 5; \
    done; \
    rm -rf /var/lib/apt/lists/*

# Cache go.mod / go.sum layer separately from source. The
# `--mount=type=cache,target=/go/pkg/mod` keeps the module download
# cache across image rebuilds — without it every package run repays
# the ~150s mod-download cost. Requires syntax=docker/dockerfile:1.7
# (declared at the top of this file).
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy the rest of the repo (build context = repo root).
COPY . .

# CGO_ENABLED=1 because of the local embedder (see top of stage 1).
# Two cache mounts:
#   /go/pkg/mod    — module download cache (same as above)
#   /root/.cache/go-build — Go's per-package compile cache; the big
#                          win — a no-op rebuild drops from ~2min to
#                          ~5s when the cache hits.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/ongrid ./cmd/ongrid

# ---------- Stage 2: runtime ----------
# ubuntu:22.04 (jammy) so the cgo binary's glibc + libstdc++ + libgomp
# deps resolve at runtime (alpine's musl would need a separate
# onnxruntime musl build that doesn't ship from upstream). The cgo binary
# is built on bookworm (glibc 2.36) but only links against symbols that
# exist in jammy's glibc 2.35 — verified by running the bookworm-built
# binary inside a jammy container before switching the base.
#
# Operators also exec into this container to debug (docker exec), so a
# usable shell + the usual Linux toolbox is installed on purpose: this
# image is a debugging surface, not a minimal distroless artifact.
FROM ubuntu:22.04

# Knowledge-base + onnxruntime runtime deps, plus the everyday Linux
# toolbox for in-container troubleshooting.
#   - git / openssh-client / ca-certificates / tzdata: same role as
#     before the bookworm switch.
#   - libgomp1: openmp runtime libonnxruntime needs.
#   - libstdc++6 / libc6: present in the base but kept explicit so a
#     future minify pass doesn't surprise us.
#   - curl / wget: fetch endpoints and the in-image entry-shim if we ever
#     inline the model download.
#   - python3 / python3-pip: the cloud_bash sandbox runs as non-root with
#     no package manager, so an agent can't install tooling at runtime; a
#     huge swath of cloud CLIs (tccli, awscli, …) are Python. Ship a usable
#     Python interpreter so cloud_bash can install + run them. The TOOLS
#     themselves are NOT baked here — they install into a host-mounted
#     persistent volume (/var/lib/ongrid/tools, the cloud_bash PYTHONUSERBASE)
#     so they survive container recreation, don't bloat the image, and can be
#     added at runtime via the approval-gated cloud_bash (no image rebuild).
#   - toolbox: procps/ps/top, net-tools/netstat/arp, iproute2/ip/ss,
#     iputils-ping/ping, dnsutils/dig/nslookup, traceroute, tcpdump, lsof,
#     vim / nano / less / tree, unzip / zip, jq, htop, sysstat, strace,
#     sudo, bash-completion, locales — everything an operator reaches for
#     when exec-ing into the container.
#   - netcat-openbsd / telnet: `nc -vz host port` is the fastest way to
#     prove an upstream is reachable without a full client.
#   - ltrace: library-call tracing, the counterpart to strace.
#   - cron / file / xz-utils / bzip2: scheduled tasks + archive handling.
#     (tailf was dropped from util-linux 2.37+ and yq is not an apt
#     package — both intentionally absent.)
# Retry up to 5× — apt mirrors intermittently 502, and a single transient
# failure here otherwise kills the whole image build. Acquire::Retries also
# retries individual package downloads within one apt run.
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8
RUN set -eux; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            git openssh-client ca-certificates tzdata libgomp1 libstdc++6 libc6 \
            curl wget \
            python3 python3-pip \
            bash bash-completion sudo locales \
            procps net-tools iproute2 iputils-ping iputils-tracepath dnsutils \
            traceroute tcpdump lsof htop sysstat strace \
            vim nano less tree unzip zip jq rsync \
            netcat-openbsd telnet ltrace cron file xz-utils bzip2 && break; \
        [ "$i" = 5 ] && exit 1; echo "apt attempt $i failed, retrying in 5s"; sleep 5; \
    done; \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone; \
    locale-gen en_US.UTF-8 2>/dev/null || true; \
    rm -rf /var/lib/apt/lists/*

# ONNX Runtime shared library. Pin the version so a future apt-mirror
# bump doesn't silently change ABI. v1.20.1 is the latest stable that
# fastembed-go's yalue/onnxruntime_go@v1.7.0 was tested against.
ARG ONNXRUNTIME_VERSION=1.20.1
ARG TARGETARCH
RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${arch}" in \
        amd64|x86_64) ORT_ARCH=x64; NUGET_RID=linux-x64 ;; \
        arm64|aarch64) ORT_ARCH=aarch64; NUGET_RID=linux-arm64 ;; \
        *) echo "unsupported arch ${arch}" >&2; exit 1 ;; \
    esac; \
    if curl -fsSL -o /tmp/ort.tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}.tgz"; then \
        tar -xzf /tmp/ort.tgz -C /tmp; \
        install -m 0755 /tmp/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}/lib/libonnxruntime.so.${ONNXRUNTIME_VERSION} /usr/lib/; \
    else \
        curl -fsSL -o /tmp/ort.nupkg \
            "https://www.nuget.org/api/v2/package/Microsoft.ML.OnnxRuntime/${ONNXRUNTIME_VERSION}"; \
        python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extract(sys.argv[2], sys.argv[3])' \
            /tmp/ort.nupkg "runtimes/${NUGET_RID}/native/libonnxruntime.so" /tmp/ort-nuget; \
        install -m 0755 /tmp/ort-nuget/runtimes/${NUGET_RID}/native/libonnxruntime.so /usr/lib/libonnxruntime.so.${ONNXRUNTIME_VERSION}; \
    fi; \
    ln -sf /usr/lib/libonnxruntime.so.${ONNXRUNTIME_VERSION} /usr/lib/libonnxruntime.so; \
    rm -rf /tmp/ort.tgz /tmp/ort.nupkg /tmp/ort-nuget /tmp/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}; \
    ldconfig
ENV ONNX_PATH=/usr/lib/libonnxruntime.so

COPY --from=builder /out/ongrid /ongrid

# Ship the agent personas read by chatruntime.LoadAll from `./agents`.
# Skill packs are installed separately at /var/lib/ongrid/skills.
COPY --from=builder /app/agents /agents

# ADR-024 edge upgrade bundles are bind-mounted from the host at
# runtime (see deploy/docker-compose.yml). install.sh / upgrade.sh
# stage `dist/.../edge-bundles/*.tar.gz` into /opt/ongrid/edge-bundles
# on the host, which we mount into this container read-only at
# /usr/share/ongrid/edge-bundles so the manager can read each bundle's
# .sha256 companion when resolving an upgrade. Bundle bytes themselves
# are served by nginx out of the existing /edge/ static location;
# manager-side download is never on the hot path.
RUN mkdir -p /usr/share/ongrid/edge-bundles

# Knowledge-base git clones land here. Bind-mount this in production
# to keep them across container restarts.
RUN mkdir -p /var/lib/ongrid/repos
WORKDIR /

# 8080 = HTTP API, 9100 = Prometheus /metrics (see ADR-004 §2).
EXPOSE 8080 9100

# Non-root user. ubuntu:22.04 has groupadd/useradd; pin to the
# same uid (65532) the old alpine layer used so file-perm semantics on
# bind-mounted /var/lib/ongrid survive the base switch.
# Need root inside a debug shell? `docker exec -u root` — no sudoers
# entry is granted, so the default runtime stays least-privilege.
# /bin/bash (not /usr/sbin/nologin) so `docker exec -it <ctr> bash` drops
# straight into a usable shell — the container is a debugging surface and
# operators rely on it. Least-privilege is unaffected: the process still
# runs as uid 65532, not root.
RUN groupadd --system --gid 65532 nonroot && \
    useradd  --system --uid 65532 --gid 65532 --no-create-home --shell /bin/bash nonroot && \
    chown -R nonroot:nonroot /var/lib/ongrid
# HOME defaults to / for useradd --no-create-home; fastembed-go's
# sugarme/tokenizer dep does $HOME/.cache/tokenizer mkdir and crashes
# on / (not writable as nonroot). Point HOME at the manager state dir
# so the tokenizer dir lands somewhere writable.
ENV HOME=/var/lib/ongrid
USER nonroot
ENTRYPOINT ["/ongrid"]
