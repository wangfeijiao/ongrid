# ═════════════════════════════════════════════════════════════
# vul-analyse 环境变量样例
# ═════════════════════════════════════════════════════════════
# 复制为 .env 后填入真实值：
#   cp .env.example .env
# 加载方式：
#   set -a && source .env && set +a
# ═════════════════════════════════════════════════════════════

# 知识库 Provider 鉴权
KB_UUID=replace_with_your_knowledge_base_uuid
KB_API_TOKEN=replace_with_your_knowledge_base_token

# 威胁情报 Provider 鉴权
INTEL_API_KEY=replace_with_your_intel_api_key

# ─────────── 默认情报工具（NVD + EPSS + OSV，无需 token 即可使用）───────────
# NVD API Key 将限速从 5 req/30s 提升到 50 req/30s（10 倍加速）
# 免费申请：https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=31c0371a-c8bb-4efe-b8b8-ad6481740966
