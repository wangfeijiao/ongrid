# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Go coverage output
*.out
coverage.out
coverage.html

# Build output
bin/
dist/stage/
dist/out/
tmp/

# Stray top-level binaries from `go build` / `go run`
/ongrid
/ongrid-frontier
/ongrid-edge

# release artifacts
dist/stage/
dist/out/
bin/linux-*
bin/darwin-*
bin/windows-*

# Dependencies
vendor/

# Go workspace file
go.work
go.work.sum

# Env files — keep .env.example
.env
.env.*
!.env.example

# Local-only config overrides
*.local.yaml
*.local.yml

# Editor / OS
.idea/
.vscode/
.DS_Store

# Claude Code transient files
.claude/
web/dist/
web/node_modules/
web/tsconfig.tsbuildinfo
api/gen/
/.playwright-cli/
/output/

# Local dev artifacts (deploy/)
deploy/docker-compose.override.yml
deploy/certs/
deploy/install/certs/
/local/

# build cache: stack-dep upstream binaries fetched by dist/package.sh
.cache/
.gstack/

# WorkBuddy agent workspace (local memory, temp scripts, downloaded binaries)
.workbuddy/

# Batch edge deployment: large binaries and credentials must never be committed
deploy-edge-batch/payload/
deploy-edge-batch/credentials.json
deploy-edge-batch/credentials-*.json
deploy-edge-batch/*credentials*.json
deploy-edge-batch/deploy-result.json
deploy-edge-batch/deploy-result-*.json
deploy-edge-batch/probe-result.json
deploy-edge-batch/probe-result.*.json
# Timestamped local snapshots (e.g. credentials.json.bak-202610301028) are
# working-copy scratch files: the name ends with the backup date, so the
# *.json patterns above never match them.
deploy-edge-batch/*.bak-*
deploy-edge-batch/.deploy*.log
# Upgrade toolchain: staging packages, downloaded assets and run logs
deploy-edge-batch/upgrade/pkg/
deploy-edge-batch/upgrade/cache/
deploy-edge-batch/upgrade/*.log
deploy-edge-batch/upgrade/*-result.json
